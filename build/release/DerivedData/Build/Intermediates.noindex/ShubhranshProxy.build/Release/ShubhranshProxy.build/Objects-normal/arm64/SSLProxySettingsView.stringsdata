      },
      {
        "comment": "",
        "key": "Traffic from phones/tablets on your Wi‑Fi is decrypted automatically so requests appear in the session list. Mac apps still use the decrypt list below.",
        "location": {
          "startingColumn": 26,
          "startingLine": 111
        }
      },
      {
        "comment": "",
        "key": "All HTTPS is decrypted except excluded hosts below. This can break Slack, banking apps, and other certificate-pinned services.",
